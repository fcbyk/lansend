{
  "private": true,
  "type": "module",
  "scripts": {
    "run": "node scripts/run-server.mjs",
    "dev": "concurrently \"vite\" \"node scripts/run-server.mjs\"",
    "build:web": "tsc -b && vite build",
    "build:web:desktop": "tsc -p desktop-web --noEmit && vite build --config vite.desktop.config.ts",
    "build:cli": "node scripts/build-cli.mjs",
    "build:desktop": "pnpm run build:web:desktop && node scripts/build-desktop.mjs",
    "build:desktop:mac": "pnpm run build:web:desktop && bash scripts/build-mac-desktop.sh",
    "build": "pnpm run build:web && pnpm run build:cli",
    "tag": "node scripts/tag.mjs",
    "release": "git push origin --tags"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}