{
  "private": true,
  "type": "module",
  "scripts": {
    "run": "./server/lansend",
    "dev": "concurrently \"vite\" \"./server/lansend --no-browser\"",
    "build:web": "tsc -b && vite build && node scripts/copy-dist.mjs",
    "build:server": "cd server && CGO_ENABLED=1 go build -ldflags=\"-s -w\" -o lansend .",
    "build": "pnpm run build:web && pnpm run build:server",
    "preview": "vite preview"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.3",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  }
}